{
  "name": "seekiee",
  "version": "1.0.0",
  "description": "Seekiee — AI-powered job search command center: evaluate offers, generate CVs, scan portals, track applications",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "web:dev": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web",
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "patterns": "node analyze-patterns.mjs",
    "gemini:eval": "node gemini-eval.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "seekiee",
    "automation"
  ],
  "author": "Seekiee <hello@darkiee.com> (https://darkiee.com)",
  "homepage": "https://darkiee.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/05-deepak-patidar/Seekiee"
  },
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  }
}
